# App
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DB_PATH=./data/school-vote.db
MAX_VOTES_PER_ORDER=1000

# Payment mode: use demo only for offline local dev.
# PAYMENT_MODE=demo

# Paystack configuration
PAYMENT_MODE=paystack
PAYSTACK_SECRET_KEY=sk_live_replace_with_your_key
PAYSTACK_CURRENCY=KES
PAYSTACK_CHANNELS=card,mobile_money,bank_transfer

# When deployed, the callback/webhook must be publicly reachable over HTTPS:
# NODE_ENV=production
# PUBLIC_BASE_URL=https://vote.yourdomain.com
# Then register https://vote.yourdomain.com/api/payments/paystack/webhook
# as the webhook URL in your Paystack dashboard.